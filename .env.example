# No Railway, se o backend e o MySQL estiverem no MESMO projeto, as variáveis
# MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE já são injetadas
# automaticamente — não precisa preencher DB_* manualmente nesse caso.
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

JWT_SECRET=
PORT=3000

# URL do seu frontend no Hostinger, para liberar CORS. Use * apenas em teste.
CORS_ORIGIN=*
